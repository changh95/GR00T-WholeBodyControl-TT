# X280 firmware (PLAN.md WP-3.2). Run from anywhere: make -C $RT/x280/fw <target>
#
#   x280   (default) build/monitor.{elf,bin,map}: the LIM image at 0x0800_0000 (crt0, monitor, trap,
#          kernel), build/park_stub.{elf,bin} (64 B at 0x2001_0100), build/stage0.{elf,bin} (E1F only),
#          build/payloads/{lim_bench,checksum,illegal,hang}.{elf,bin} (LOAD/CALL payloads at 0x0801_1000),
#          build/payloads/mh_bench.{elf,bin} (the 4-hart bench payload at 0x081D_F400, mh_bench.ld)
#   x86    build/x86/libmonitor_x86.so (monitor + kernel + fake platform, for ctypes tests),
#          build/x86-stub/libmonitor_x86.so (the same with the stub kernel) and
#          build/x86-crcbit/libmonitor_x86.so (stub kernel, -DMON_CRC_BITWISE: the bitwise CRC reference)
#   spike  build/spike/monitor_spike.{elf,bin} (SPIKE_HOST runner, SPIKE_HOST.md) and
#          build/spike/stage0_spike.elf; SPIKE_CRC_BITWISE=1 builds it with the bitwise CRC (tests only)
#   check  scripts/check_image.py on build/monitor.elf (T-3.2; needs python3), after amo-scan
#   amo-scan  objdump of monitor.elf and every payload: no amo*/lr/sc instruction (LIM is uncached; the A extension
#          is implemented at L1D, Caches.md:26-34)
#   clean  removes this Makefile's outputs (not the kernel lane's build/kernel)
#
# The kernel comes from the kernel lane's Makefile.kernel (WBCK_* variables) when it exists; otherwise,
# or with FW_FORCE_STUB=1, wbc_stub.c is linked and every INFER fails with MB_ERR_KERNEL (said below).
# Builds are pinned like every other build here: nice 19 on X280_CPUS, off the real-time cores 2,3,4,6,7,12-15
# and their SMT siblings 18,19,20,22,23,28-31.

.DEFAULT_GOAL := x280

ifneq ($(wildcard Makefile.kernel),)
include Makefile.kernel
endif
.DEFAULT_GOAL := x280

FW_CC      ?= clang-20
FW_LD      ?= ld.lld-20
FW_OBJCOPY ?= llvm-objcopy-20
X280_CPUS  ?= 0,1,8-11,16,17,24-27
FW_PIN     ?= nice -n 19 taskset -c $(X280_CPUS)
FW_B       := build

FW_RV_ARCH    := --target=riscv64-unknown-elf -march=rv64gcv_zfh_zba_zbb -mabi=lp64d -mcmodel=medany
FW_COMMON     := -std=c11 -O2 -Wall -Wextra -ffp-contract=off -fno-strict-aliasing -I.
FW_RV_CFLAGS  := $(FW_RV_ARCH) $(FW_COMMON) -ffreestanding -fno-builtin -nostdlib -fno-vectorize \
                 -fno-slp-vectorize -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables \
                 -fno-unwind-tables -fno-stack-protector -fno-pic
FW_RV_ASFLAGS := $(FW_RV_ARCH) -I.
FW_X86_CFLAGS := $(FW_COMMON) -g -fPIC -fvisibility=hidden -DMON_X86
FW_X86_MONFLAGS := $(FW_X86_CFLAGS) -ffreestanding -fno-builtin

# ---- kernel selection -------------------------------------------------------------------------------
ifeq ($(FW_FORCE_STUB),1)
FW_KERNEL := stub
else ifneq ($(strip $(WBCK_RV64_OBJS)),)
FW_KERNEL := real
else
FW_KERNEL := stub
endif
ifeq ($(FW_KERNEL),real)
FW_RV_KOBJS  := $(WBCK_RV64_OBJS) $(FW_B)/obj/rv/wbc_glue.o
FW_KSRCS     := $(WBCK_SRCS) wbc_glue.c
else
FW_RV_KOBJS  := $(FW_B)/obj/rv/wbc_stub.o
FW_KSRCS     := wbc_stub.c
$(info [x280/fw] kernel: Makefile.kernel/wbc_mlp.c not used -> linking wbc_stub.c: every INFER fails with MB_ERR_KERNEL (-1))
endif

FW_HDRS   := mailbox.h plat.h monitor.h wbc_api.h asm.h crc32_tab.h mh.h $(wildcard wbc_mlp.h)
FW_MON_C  := monitor.c trap.c mh.c mon_libc.c

# Build id (L36.build_id, persistent-block cookie): cksum of every source that can end up in an image.
# Written to build/gen/build_id.c only when it changes, so objects are rebuilt exactly when needed.
FW_ID_SRCS  := $(sort $(wildcard *.c *.S *.h *.ld) $(FW_KSRCS))
FW_BUILD_ID := $(shell cat $(FW_ID_SRCS) 2>/dev/null | cksum | cut -d' ' -f1)
FW_GEN      := $(FW_B)/gen
FW_GEN_ID   := $(FW_GEN)/build_id.c
FW_KSTAMP   := $(FW_GEN)/kernel_choice
.PHONY: FORCE_GEN
FORCE_GEN:
$(FW_GEN_ID): FORCE_GEN
	@mkdir -p $(@D)
	@printf '/* generated by x280/fw/Makefile */\n#include <stdint.h>\nconst uint32_t mon_build_id = %su;\n' \
	    $(FW_BUILD_ID) > $@.tmp; cmp -s $@.tmp $@ || mv $@.tmp $@; rm -f $@.tmp
$(FW_KSTAMP): FORCE_GEN
	@mkdir -p $(@D)
	@echo '$(FW_KERNEL)' > $@.tmp; cmp -s $@.tmp $@ || mv $@.tmp $@; rm -f $@.tmp

# ---- x280 image ---------------------------------------------------------------------------------------
FW_RV_OBJS := $(FW_B)/obj/rv/crt0.o $(FW_B)/obj/rv/monitor.o $(FW_B)/obj/rv/trap.o $(FW_B)/obj/rv/mh.o \
              $(FW_B)/obj/rv/mon_libc.o $(FW_B)/obj/rv/build_id.o

$(FW_B)/obj/rv/%.o: %.c $(FW_HDRS)
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -c -o $@ $<

$(FW_B)/obj/rv/build_id.o: $(FW_GEN_ID)
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -c -o $@ $<

$(FW_B)/obj/rv/%.o: %.S asm.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_ASFLAGS) -c -o $@ $<

$(FW_B)/monitor.elf: $(FW_RV_OBJS) $(FW_RV_KOBJS) lim.ld $(FW_KSTAMP)
	$(FW_PIN) $(FW_LD) -T lim.ld --gc-sections -Map=$(FW_B)/monitor.map -o $@ $(FW_RV_OBJS) $(FW_RV_KOBJS)

$(FW_B)/park_stub.elf: $(FW_B)/obj/rv/park_stub.o
	$(FW_LD) --section-start=.park=0x20010100 -e park_stub -o $@ $<

$(FW_B)/stage0.elf: $(FW_B)/obj/rv/stage0.o
	$(FW_LD) --section-start=.stage0=0x20010100 -e stage0_start -o $@ $<

# Monitor/stubs: loadable sections only (crt0 clears .bss). Payloads: .bss emitted as zeros so the
# LOAD CRC covers it (payload.ld).
%.bin: %.elf
	$(FW_OBJCOPY) -O binary $< $@
$(FW_B)/payloads/%.bin: $(FW_B)/payloads/%.elf
	$(FW_OBJCOPY) -O binary --set-section-flags .bss=alloc,load,contents $< $@

# Payloads: one ELF each, linked at PAYLOAD_ADDR (payload.ld).
FW_PAY_ADDR ?= 0x08011000
FW_PAYLOADS := lim_bench checksum illegal hang mh_bench
$(FW_B)/payloads/lim_bench.o: lim_bench.c mailbox.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -c -o $@ $<
$(FW_B)/payloads/checksum.o: payloads.c mailbox.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -DPAYLOAD_CHECKSUM -c -o $@ $<
$(FW_B)/payloads/illegal.o: payloads.c mailbox.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -DPAYLOAD_ILLEGAL -c -o $@ $<
$(FW_B)/payloads/hang.o: payloads.c mailbox.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -DPAYLOAD_HANG -c -o $@ $<
$(FW_B)/payloads/%.elf: $(FW_B)/payloads/%.o payload.ld
	$(FW_LD) -T payload.ld --defsym=PAYLOAD_ADDR=$(FW_PAY_ADDR) --gc-sections -o $@ $<
# mh_bench: its own fixed address and data lines (mh_bench.ld, mh.h MHB_*)
# -Os: code and tables must fit the 2,624 B before the data lines (mh_bench.ld asserts it)
$(FW_B)/payloads/mh_bench.o: mh_bench.c mh.h mailbox.h asm.h
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) -Os -c -o $@ $<
$(FW_B)/payloads/mh_bench.elf: $(FW_B)/payloads/mh_bench.o mh_bench.ld
	$(FW_LD) -T mh_bench.ld --gc-sections -o $@ $<

FW_X280_OUT := $(FW_B)/monitor.elf $(FW_B)/monitor.bin $(FW_B)/park_stub.elf $(FW_B)/park_stub.bin \
               $(FW_B)/stage0.elf $(FW_B)/stage0.bin \
               $(foreach p,$(FW_PAYLOADS),$(FW_B)/payloads/$(p).elf $(FW_B)/payloads/$(p).bin)

.PHONY: x280 x86 spike check amo-scan clean
x280: $(FW_X280_OUT)
	@echo "[x280/fw] kernel=$(FW_KERNEL) build_id=$(FW_BUILD_ID)"; \
	 printf '[x280/fw] monitor.bin %s B (limit 49152), park_stub.bin %s B, stage0.bin %s B\n' \
	   $$(stat -c %s $(FW_B)/monitor.bin) $$(stat -c %s $(FW_B)/park_stub.bin) $$(stat -c %s $(FW_B)/stage0.bin)

check: x280 amo-scan
	python3 ../../scripts/check_image.py $(FW_B)/monitor.elf

FW_OBJDUMP ?= llvm-objdump-20
amo-scan: x280
	@n=$$(for f in $(FW_B)/monitor.elf $(foreach p,$(FW_PAYLOADS),$(FW_B)/payloads/$(p).elf); do \
	    $(FW_OBJDUMP) -d --mattr=+a,+v,+zfh --no-show-raw-insn $$f; done | \
	    grep -cE '^ +[0-9a-f]+:[[:space:]]+(amo[a-z]+|lr|sc)\.[wd]'); \
	 echo "[x280/fw] amo/lr/sc instructions in the monitor and payloads: $$n (must be 0)"; test "$$n" = 0

# ---- x86 test library ---------------------------------------------------------------------------------
FW_X86_MON := monitor.c trap.c mh.c
FW_X86_SHIM := plat_x86.c payloads.c lim_bench.c mh_bench.c

# $(1) = output dir, $(2) = extra flags for every object of that library
define FW_X86_LIB
$(1)/obj/%.mon.o: %.c $$(FW_HDRS)
	@mkdir -p $$(@D)
	$$(FW_PIN) $$(FW_CC) $$(FW_X86_MONFLAGS) $(2) -c -o $$@ $$<
$(1)/obj/%.shim.o: %.c $$(FW_HDRS)
	@mkdir -p $$(@D)
	$$(FW_PIN) $$(FW_CC) $$(FW_X86_CFLAGS) $(2) -c -o $$@ $$<
$(1)/obj/build_id.o: $$(FW_GEN_ID)
	@mkdir -p $$(@D)
	$$(FW_PIN) $$(FW_CC) $$(FW_X86_CFLAGS) -c -o $$@ $$<
endef
$(eval $(call FW_X86_LIB,$(FW_B)/x86,))
$(eval $(call FW_X86_LIB,$(FW_B)/x86-stub,))
$(eval $(call FW_X86_LIB,$(FW_B)/x86-crcbit,-DMON_CRC_BITWISE))

ifeq ($(FW_KERNEL),real)
FW_X86_KOBJS := $(FW_B)/x86/obj/wbc_mlp.k.o $(FW_B)/x86/obj/elu.k.o $(FW_B)/x86/obj/wbc_glue.shim.o
$(FW_B)/x86/obj/%.k.o: %.c $(WBCK_HDRS)
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(WBCK_X86_CFLAGS) -c -o $@ $<
else
FW_X86_KOBJS := $(FW_B)/x86/obj/wbc_stub.shim.o
endif

$(FW_B)/x86/libmonitor_x86.so: $(patsubst %.c,$(FW_B)/x86/obj/%.mon.o,$(FW_X86_MON)) \
                               $(patsubst %.c,$(FW_B)/x86/obj/%.shim.o,$(FW_X86_SHIM)) $(FW_X86_KOBJS) \
                               $(FW_B)/x86/obj/build_id.o $(FW_KSTAMP)
	$(FW_PIN) $(FW_CC) -shared -pthread -o $@ $(filter %.o,$^)

$(FW_B)/x86-stub/libmonitor_x86.so: $(patsubst %.c,$(FW_B)/x86-stub/obj/%.mon.o,$(FW_X86_MON)) \
                                    $(patsubst %.c,$(FW_B)/x86-stub/obj/%.shim.o,$(FW_X86_SHIM)) \
                                    $(FW_B)/x86-stub/obj/wbc_stub.shim.o $(FW_B)/x86-stub/obj/build_id.o
	$(FW_PIN) $(FW_CC) -shared -pthread -o $@ $^

# The bitwise-CRC reference (tests/x280/test_crc32.py): the stub kernel is enough, nothing there runs INFER.
$(FW_B)/x86-crcbit/libmonitor_x86.so: $(patsubst %.c,$(FW_B)/x86-crcbit/obj/%.mon.o,$(FW_X86_MON)) \
                                      $(patsubst %.c,$(FW_B)/x86-crcbit/obj/%.shim.o,$(FW_X86_SHIM)) \
                                      $(FW_B)/x86-crcbit/obj/wbc_stub.shim.o $(FW_B)/x86-crcbit/obj/build_id.o
	$(FW_PIN) $(FW_CC) -shared -pthread -o $@ $^

x86: $(FW_B)/x86/libmonitor_x86.so $(FW_B)/x86-stub/libmonitor_x86.so $(FW_B)/x86-crcbit/libmonitor_x86.so
	@echo "[x280/fw] x86 kernel=$(FW_KERNEL)"

# ---- spike (SPIKE_HOST) ------------------------------------------------------------------------------
# Configuration (SPIKE_HOST.md): SPIKE_SCRIPT (C file defining sh_script[]), SPIKE_BLOB, SPIKE_OBS,
# SPIKE_OUT, SPIKE_N, SPIKE_POLICY, SPIKE_VARIANT, SPIKE_X280_REGIONS=1, SPIKE_CRC_BITWISE=1, SPIKE_BUILD (output dir),
# SPIKE_MH=1 (+ SPIKE_SCRIPT=spike_script_mh.c, SPIKE_X280_REGIONS=1; SPIKE_MH_AUDIT=1: the short audit subset).
SPIKE_BUILD   ?= $(FW_B)/spike
SPIKE_SCRIPT  ?= spike_script_default.c
SPIKE_DEFS    := -DSPIKE_HOST
ifneq ($(SPIKE_BLOB),)
SPIKE_DEFS += -DSPIKE_BLOB='"$(abspath $(SPIKE_BLOB))"'
endif
ifneq ($(SPIKE_OBS),)
SPIKE_DEFS += -DSPIKE_OBS='"$(abspath $(SPIKE_OBS))"'
endif
ifneq ($(SPIKE_OUT),)
SPIKE_DEFS += -DSPIKE_OUT='"$(abspath $(SPIKE_OUT))"'
endif
ifneq ($(SPIKE_N),)
SPIKE_DEFS += -DSPIKE_N=$(SPIKE_N)
endif
ifneq ($(SPIKE_POLICY),)
SPIKE_DEFS += -DSPIKE_POLICY=$(SPIKE_POLICY)
endif
ifneq ($(SPIKE_VARIANT),)
SPIKE_DEFS += -DSPIKE_VARIANT=$(SPIKE_VARIANT)
endif
ifeq ($(SPIKE_X280_REGIONS),1)
SPIKE_DEFS += -DSPIKE_X280_REGIONS
endif
# The bitwise mon_crc32 (no table) in place of slicing-by-8: the before/after instruction counts (test_spike.py).
ifeq ($(SPIKE_CRC_BITWISE),1)
SPIKE_DEFS += -DMON_CRC_BITWISE
endif
# With SPIKE_X280_REGIONS: leave hart 0's reset handler address at the E1F stage-0 entry 0x2001_0100, as an E1F
# boot does (review F1); the park stub must still reach crt0.
ifeq ($(SPIKE_E1F_VECTORS),1)
SPIKE_DEFS += -DSPIKE_E1F_VECTORS
endif
# SPIKE_MH=1: embed build/payloads/mh_bench.bin (sh_bin_mh_bench) for a multi-hart script (spike_script_mh.c, -p4)
ifeq ($(SPIKE_MH),1)
SPIKE_DEFS += -DSPIKE_MH
endif
ifeq ($(SPIKE_MH_AUDIT),1)
SPIKE_DEFS += -DSPIKE_MH_AUDIT
endif
SPIKE_PAY := $(abspath $(FW_B)/payloads)
ifeq ($(SPIKE_MH),1)
SPIKE_INC := -DSH_BIN_MH_BENCH='"$(SPIKE_PAY)/mh_bench.bin"' -DSH_BIN_PARK='"$(abspath $(FW_B)/park_stub.bin)"'
else
SPIKE_INC := -DSH_BIN_CHECKSUM='"$(SPIKE_PAY)/checksum.bin"' -DSH_BIN_ILLEGAL='"$(SPIKE_PAY)/illegal.bin"' \
             -DSH_BIN_HANG='"$(SPIKE_PAY)/hang.bin"' -DSH_BIN_LIM_BENCH='"$(SPIKE_PAY)/lim_bench.bin"' \
             -DSH_BIN_PARK='"$(abspath $(FW_B)/park_stub.bin)"'
endif

SPIKE_OBJS := $(SPIKE_BUILD)/obj/crt0.o $(SPIKE_BUILD)/obj/monitor.o $(SPIKE_BUILD)/obj/trap.o $(SPIKE_BUILD)/obj/mh.o \
              $(SPIKE_BUILD)/obj/mon_libc.o $(SPIKE_BUILD)/obj/spike_host.o $(SPIKE_BUILD)/obj/script.o \
              $(SPIKE_BUILD)/obj/spike_payloads.o $(FW_B)/obj/rv/build_id.o

$(SPIKE_BUILD)/obj/%.o: %.c $(FW_HDRS) spike_host.h FORCE_SPIKE
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) $(SPIKE_DEFS) -c -o $@ $<
$(SPIKE_BUILD)/obj/%.o: %.S asm.h FORCE_SPIKE
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_ASFLAGS) $(SPIKE_DEFS) -c -o $@ $<
$(SPIKE_BUILD)/obj/script.o: $(SPIKE_SCRIPT) $(FW_HDRS) spike_host.h FORCE_SPIKE
	@mkdir -p $(@D)
	$(FW_PIN) $(FW_CC) $(FW_RV_CFLAGS) $(SPIKE_DEFS) -c -o $@ $<
$(SPIKE_BUILD)/obj/spike_payloads.o: spike_payloads.S $(foreach p,$(FW_PAYLOADS),$(FW_B)/payloads/$(p).bin) \
                                     $(FW_B)/park_stub.bin FORCE_SPIKE
	@mkdir -p $(@D)
	$(FW_CC) $(FW_RV_ASFLAGS) $(SPIKE_INC) -c -o $@ $<

# Stack reservation of the SPIKE_HOST link (lim.ld __stack_size; it only feeds the "bss + persist overlap the stack"
# ASSERT, the stack top is fixed at 0x0801_0000). The runner adds ~14 KiB that the X280 image does not have (the
# script, the harness code, the obs staging buffer, the embedded payloads) below the stack, and the deepest chain
# of frames (-fstack-usage: sh_run, mon_poll_once, cmd_bench, wbc_infer, forward, gemv) is ~1.2 KiB, so 2 KiB is
# reserved here instead of the X280 image's 16 KiB, with the compact 4 KiB multi-hart region below it (MH_SPIKE,
# asm.h; spike -p4's one-writer audit would show a hart-0 store into it). --defsym goes before -T: lld runs both in
# command-line order, and lim.ld's DEFINED(__stack_size) must already see it.
SPIKE_STACK ?= 0x800
$(SPIKE_BUILD)/monitor_spike.elf: $(SPIKE_OBJS) $(FW_RV_KOBJS) lim.ld
	$(FW_PIN) $(FW_LD) --defsym=__stack_size=$(SPIKE_STACK) --defsym=MH_SPIKE=1 -T lim.ld --gc-sections \
	    -Map=$(SPIKE_BUILD)/monitor_spike.map -o $@ $(SPIKE_OBJS) $(FW_RV_KOBJS)

$(SPIKE_BUILD)/stage0_spike.elf: $(FW_B)/obj/rv/stage0.o $(SPIKE_BUILD)/obj/stage0_spike.o stage0_spike.ld
	$(FW_LD) -T stage0_spike.ld -o $@ $(FW_B)/obj/rv/stage0.o $(SPIKE_BUILD)/obj/stage0_spike.o

.PHONY: FORCE_SPIKE
FORCE_SPIKE:

spike: $(SPIKE_BUILD)/monitor_spike.elf $(SPIKE_BUILD)/monitor_spike.bin $(SPIKE_BUILD)/stage0_spike.elf
	@echo "[x280/fw] spike image $(SPIKE_BUILD)/monitor_spike.elf (kernel=$(FW_KERNEL), script=$(SPIKE_SCRIPT))"

clean:
	rm -rf $(FW_B)/obj $(FW_B)/x86 $(FW_B)/x86-stub $(FW_B)/x86-crcbit $(FW_B)/spike $(FW_B)/payloads $(FW_B)/gen \
	       $(FW_B)/monitor.* $(FW_B)/park_stub.* $(FW_B)/stage0.*
